# Copie para infra/producao/.env (ignorado pelo git) e preencha. Os scripts de implantar,
# publicar atualização e instalar no iPhone leem daqui.

# Endereço público da API (ex.: o do Tailscale Funnel do servidor).
URL_PUBLICA=https://seu-servidor.exemplo.ts.net

# Alias SSH do servidor no ~/.ssh/config (um para a rede de casa, outro pelo Tailscale).
SSH_HOST=servidor

# ID do time de assinatura da Apple (Xcode > Ajustes > Apple Accounts), para pnpm instalar-iphone.
TEAM=
